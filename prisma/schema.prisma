generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  CREATED
  CLARIFYING
  RETRIEVING
  CHECKING_DOCUMENTS
  WAITING_CONFIRMATION
  COMPLETED
  FAILED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  tasks     Task[]
}

model Task {
  id          String     @id @default(cuid())
  userId      String
  title       String
  serviceType String
  status      TaskStatus @default(CREATED)
  riskLevel   RiskLevel  @default(LOW)
  profile     Json
  result      Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id])
  messages    Message[]
  documents   Document[]
  evidence    Evidence[]
}

model Message {
  id        String   @id @default(cuid())
  taskId    String
  role      String
  content   String
  toolCalls Json?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id])
}

model Document {
  id           String   @id @default(cuid())
  taskId       String
  fileName     String
  mimeType     String
  storageKey   String
  ocrResult    Json?
  qualityScore Float?
  piiMasked    Boolean  @default(false)
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  task         Task     @relation(fields: [taskId], references: [id])
}

model PolicyChunk {
  id          String   @id @default(cuid())
  title       String
  region      String?
  serviceType String
  effectiveAt DateTime?
  expiredAt   DateTime?
  content     String
  sourceUrl   String
  section     String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([region, serviceType, effectiveAt, expiredAt])
}

model Evidence {
  id        String   @id @default(cuid())
  taskId    String
  policyId  String
  quote     String
  relevance Float
  reason    String
  task      Task     @relation(fields: [taskId], references: [id])
}
