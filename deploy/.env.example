# Read by docker compose in this directory.
# bootstrap.sh writes the real values here (chmod 600) during deployment.

# Required: must point at this server. Use a real domain, or a free
# wildcard-DNS name such as 203.0.113.10.sslip.io / 203.0.113.10.nip.io
DOMAIN=demo.example.com

# Required in practice: without it /admin/policies accepts anonymous writes.
# Generate with: openssl rand -hex 24
# bootstrap.sh generates one automatically when this is empty.
ADMIN_TOKEN=

# Optional: enables DeepSeek item classification and summaries.
# Leave empty to run on the rule-based fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
