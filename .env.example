SMART_AI_DB_PATH=".data/smart-ai.sqlite"
ADMIN_TOKEN=""
# 模型端点：官方 API 填 Key；本地部署（Ollama/vLLM/SGLang）只填 BASE_URL，Key 留空
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
# 单次调用超时（毫秒），默认 8000；本地模型慢可调大到 60000
DEEPSEEK_TIMEOUT_MS=""
# 联网核验：任选一个填 Key 即可启用，按 Tavily → 博查 → Serper 顺序优先
# 全部留空时默认用搜狗网页检索（无需 Key）；也可用 WEB_SEARCH_PROVIDER 指定通道
TAVILY_API_KEY=""
BOCHA_API_KEY=""
SERPER_API_KEY=""
WEB_SEARCH_PROVIDER=""
WEB_SEARCH_DISABLED=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
